rules_version = '2';
service cloud.firestore { match /databases/{db}/documents {
  match /chapters/{id} { allow read: if request.auth != null; allow write: if false; }
  match /users/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
  match /progress/{uid}/chapters/{id} { allow read, write: if request.auth != null && request.auth.uid == uid; }
}}
